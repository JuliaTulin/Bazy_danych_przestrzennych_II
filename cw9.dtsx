        public void Main()
        {
            string fullFileName = (string)Dts.Variables["User::FullFileName"].Value;
            bool exists = File.Exists(fullFileName);

            Dts.Variables["User::FullFileExists"].Value = exists;

            Dts.TaskResult = (int)ScriptResults.Success;
